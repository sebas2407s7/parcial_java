<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %>
<sql:query var="proyectosControl" dataSource="${db}">SELECT p.id,p.codigo,p.titulo,p.estado,p.modalidad,u.nombre AS estudiante FROM parcial_joan_carlos.anteproyectos p JOIN parcial_joan_carlos.usuarios u ON u.id=p.estudiante_id WHERE CAST(? AS TEXT)='COORDINACION' OR p.estudiante_id=CAST(? AS BIGINT) OR p.director_id=CAST(? AS BIGINT) OR p.evaluador_id=CAST(? AS BIGINT) ORDER BY p.id DESC LIMIT 70<sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${sessionScope.idUsuario}"/></sql:query><c:if test="${pageContext.request.method eq 'POST' and not empty sessionScope.csrf and param.csrf eq sessionScope.csrf and param.accion eq 'programar' and sessionScope.rol eq 'COORDINACION'}"><c:catch var="fallo"><sql:update dataSource="${db}">INSERT INTO parcial_joan_carlos.sustentaciones(anteproyecto_id,fecha,lugar,participantes,registrado_por) SELECT p.id,CAST(? AS TIMESTAMP),CAST(? AS TEXT),CAST(? AS TEXT),CAST(? AS BIGINT) FROM parcial_joan_carlos.anteproyectos p WHERE p.id=CAST(? AS BIGINT) AND p.estado IN ('APROBADO','FINALIZADO') AND EXISTS(SELECT 1 FROM parcial_joan_carlos.entregas_finales e WHERE e.anteproyecto_id=p.id AND e.estado='EVALUADO') ON CONFLICT(anteproyecto_id) DO NOTHING<sql:param value="${param.fecha}"/><sql:param value="${param.lugar}"/><sql:param value="${param.participantes}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${param.id}"/></sql:update></c:catch></c:if>
<c:if test="${pageContext.request.method eq 'POST' and not empty sessionScope.csrf and param.csrf eq sessionScope.csrf and param.accion eq 'concepto' and sessionScope.rol eq 'EVALUADOR'}"><c:catch var="fallo"><sql:update dataSource="${db}">UPDATE parcial_joan_carlos.sustentaciones s SET concepto=CAST(? AS TEXT),estado=CAST(? AS TEXT) FROM parcial_joan_carlos.anteproyectos p WHERE s.id=CAST(? AS BIGINT) AND s.anteproyecto_id=p.id AND p.evaluador_id=CAST(? AS BIGINT) AND CAST(? AS TEXT) IN ('APROBADA','APLAZADA')<sql:param value="${param.concepto}"/><sql:param value="${param.estado}"/><sql:param value="${param.sustentacion}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${param.estado}"/></sql:update></c:catch></c:if>
<c:if test="${pageContext.request.method eq 'POST' and not empty sessionScope.csrf and param.csrf eq sessionScope.csrf and param.accion eq 'publicar' and sessionScope.rol eq 'COORDINACION'}"><c:catch var="fallo"><sql:update dataSource="${db}">INSERT INTO parcial_joan_carlos.publicaciones(anteproyecto_id,acceso,url,motivo) SELECT p.id,CAST(? AS TEXT),CAST(? AS TEXT),CAST(? AS TEXT) FROM parcial_joan_carlos.anteproyectos p JOIN parcial_joan_carlos.sustentaciones s ON s.anteproyecto_id=p.id AND s.estado='APROBADA' WHERE p.id=CAST(? AS BIGINT) ON CONFLICT(anteproyecto_id) DO NOTHING<sql:param value="${param.acceso}"/><sql:param value="${param.enlace}"/><sql:param value="${param.motivo}"/><sql:param value="${param.id}"/></sql:update></c:catch></c:if>
<sql:query var="sust" dataSource="${db}">SELECT s.id,s.fecha,s.lugar,s.estado,s.concepto,p.codigo,p.titulo FROM parcial_joan_carlos.sustentaciones s JOIN parcial_joan_carlos.anteproyectos p ON p.id=s.anteproyecto_id WHERE CAST(? AS TEXT)='COORDINACION' OR p.estudiante_id=CAST(? AS BIGINT) OR p.director_id=CAST(? AS BIGINT) OR p.evaluador_id=CAST(? AS BIGINT) ORDER BY s.fecha DESC LIMIT 80<sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${sessionScope.idUsuario}"/></sql:query>
<c:set var="titulo" value="Sustentación y repositorio"/><c:set var="subtitulo" value="Cierre académico sujeto a aval documental y decisión registrada."/><%@ include file="/WEB-INF/jspf/cabecera.jspf" %><c:if test="${not empty fallo}"><div class="alert bad">La operación no fue autorizada o faltan requisitos académicos.</div></c:if><c:if test="${sessionScope.rol eq 'COORDINACION'}"><section class="panel"><h2>Programar sustentación</h2><form method="post"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><label>Expediente<select name="id" required><option value="">Selecciona un expediente</option><c:forEach var="p" items="${proyectosControl.rows}"><option value="${p.id}"><c:out value="${p.codigo}"/> · <c:out value="${p.titulo}"/></option></c:forEach></select></label><input type="hidden" name="accion" value="programar"><div class="grid"><label>Fecha y hora<input type="datetime-local" name="fecha" required></label><label>Lugar / medio<input name="lugar" maxlength="200" required></label></div><label>Participantes<textarea name="participantes" maxlength="900"></textarea></label><button>Programar</button></form></section><section class="panel"><h2>Gestión de repositorio</h2><p>Una publicación solo se admite si la sustentación figura aprobada.</p><form method="post"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><label>Expediente<select name="id" required><option value="">Selecciona un expediente</option><c:forEach var="p" items="${proyectosControl.rows}"><option value="${p.id}"><c:out value="${p.codigo}"/> · <c:out value="${p.titulo}"/></option></c:forEach></select></label><input type="hidden" name="accion" value="publicar"><label>Restricción de acceso<select name="acceso"><option>PUBLICO</option><option>RESTRINGIDO</option><option>RESERVADO</option></select></label><label>URL de repositorio<input name="enlace" type="url" maxlength="900"></label><label>Motivo y propiedad intelectual<textarea name="motivo" required maxlength="1000"></textarea></label><button>Registrar publicación</button></form></section></c:if><section class="panel"><h2>Sustentaciones registradas</h2><table><thead><tr><th>Expediente</th><th>Fecha</th><th>Lugar</th><th>Estado</th><th>Concepto</th></tr></thead><tbody><c:forEach var="s" items="${sust.rows}"><tr><td><c:out value="${s.codigo}"/></td><td><c:out value="${s.fecha}"/></td><td><c:out value="${s.lugar}"/></td><td><c:out value="${s.estado}"/></td><td><c:out value="${s.concepto}"/><c:if test="${sessionScope.rol eq 'EVALUADOR' and s.estado eq 'PROGRAMADA'}"><form method="post"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="accion" value="concepto"><input type="hidden" name="sustentacion" value="${s.id}"><label>Concepto<input name="concepto" maxlength="300" required></label><button name="estado" value="APROBADA">Aprobar</button><button class="secondary" name="estado" value="APLAZADA">Aplazar</button></form></c:if></td></tr></c:forEach></tbody></table></section><%@ include file="/WEB-INF/jspf/pie.jspf" %>