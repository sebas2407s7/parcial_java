<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %>
<sql:query var="proyectosControl" dataSource="${db}">SELECT p.id,p.codigo,p.titulo,p.estado,p.modalidad,u.nombre AS estudiante FROM parcial_joan_carlos.anteproyectos p JOIN parcial_joan_carlos.usuarios u ON u.id=p.estudiante_id WHERE CAST(? AS TEXT)='COORDINACION' OR p.estudiante_id=CAST(? AS BIGINT) OR p.director_id=CAST(? AS BIGINT) OR p.evaluador_id=CAST(? AS BIGINT) ORDER BY p.id DESC LIMIT 70<sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${sessionScope.idUsuario}"/></sql:query><c:if test="${pageContext.request.method eq 'POST' and not empty sessionScope.csrf and param.csrf eq sessionScope.csrf and param.accion eq 'enviar' and sessionScope.rol eq 'ESTUDIANTE'}"><c:catch var="fallo"><sql:update dataSource="${db}">INSERT INTO parcial_joan_carlos.entregas_finales(anteproyecto_id,autor_id,tipo,version,enlace,observaciones) SELECT id,CAST(? AS BIGINT),CAST(? AS TEXT),CAST(? AS INTEGER),CAST(? AS TEXT),CAST(? AS TEXT) FROM parcial_joan_carlos.anteproyectos WHERE id=CAST(? AS BIGINT) AND estudiante_id=CAST(? AS BIGINT) AND estado IN ('APROBADO','INFORME_EN_REVISION','EN_DESARROLLO','INFORME_DEVUELTO')<sql:param value="${sessionScope.idUsuario}"/><sql:param value="${param.tipo}"/><sql:param value="${param.version}"/><sql:param value="${param.enlace}"/><sql:param value="${param.comentario}"/><sql:param value="${param.id}"/><sql:param value="${sessionScope.idUsuario}"/></sql:update></c:catch></c:if>
<c:if test="${pageContext.request.method eq 'POST' and not empty sessionScope.csrf and param.csrf eq sessionScope.csrf and param.accion eq 'avalar' and sessionScope.rol eq 'DIRECTOR'}"><c:catch var="fallo"><sql:update dataSource="${db}">UPDATE parcial_joan_carlos.entregas_finales e SET estado=CAST(? AS TEXT),observaciones=CAST(? AS TEXT) FROM parcial_joan_carlos.anteproyectos p WHERE e.id=CAST(? AS BIGINT) AND e.anteproyecto_id=p.id AND p.director_id=CAST(? AS BIGINT) AND e.estado='ENVIADO' AND CAST(? AS TEXT) IN ('AVALADO','DEVUELTO') <sql:param value="${param.estado}"/><sql:param value="${param.observacion}"/><sql:param value="${param.entrega}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${param.estado}"/></sql:update></c:catch></c:if>
<c:if test="${pageContext.request.method eq 'POST' and not empty sessionScope.csrf and param.csrf eq sessionScope.csrf and param.accion eq 'evaluar' and sessionScope.rol eq 'EVALUADOR'}"><c:catch var="fallo"><sql:update dataSource="${db}">UPDATE parcial_joan_carlos.entregas_finales e SET estado=CAST(? AS TEXT),observaciones=CAST(? AS TEXT) FROM parcial_joan_carlos.anteproyectos p WHERE e.id=CAST(? AS BIGINT) AND e.anteproyecto_id=p.id AND p.evaluador_id=CAST(? AS BIGINT) AND e.estado='AVALADO' AND CAST(? AS TEXT) IN ('EVALUADO','CORRECCION') <sql:param value="${param.estado}"/><sql:param value="${param.observacion}"/><sql:param value="${param.entrega}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${param.estado}"/></sql:update></c:catch></c:if>
<sql:query var="entregas" dataSource="${db}">SELECT e.id,e.tipo,e.version,e.enlace,e.estado,e.observaciones,e.creado_en,p.codigo,p.titulo FROM parcial_joan_carlos.entregas_finales e JOIN parcial_joan_carlos.anteproyectos p ON p.id=e.anteproyecto_id WHERE CAST(? AS TEXT)='COORDINACION' OR p.estudiante_id=CAST(? AS BIGINT) OR p.director_id=CAST(? AS BIGINT) OR p.evaluador_id=CAST(? AS BIGINT) ORDER BY e.creado_en DESC LIMIT 100<sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${sessionScope.idUsuario}"/></sql:query>
<c:set var="titulo" value="Informe y entregables"/><c:set var="subtitulo" value="Control documental: carga del estudiante, aval del director y revisión del evaluador."/><%@ include file="/WEB-INF/jspf/cabecera.jspf" %><c:if test="${not empty fallo}"><div class="alert bad">La operación no se completó. Comprueba estado, formato y permisos.</div></c:if><c:if test="${sessionScope.rol eq 'ESTUDIANTE'}"><section class="panel"><h2>Registrar nueva versión</h2><form method="post"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><label>Expediente<select name="id" required><option value="">Selecciona un expediente</option><c:forEach var="p" items="${proyectosControl.rows}"><option value="${p.id}"><c:out value="${p.codigo}"/> · <c:out value="${p.titulo}"/></option></c:forEach></select></label><input type="hidden" name="accion" value="enviar"><div class="grid"><label>Documento<select name="tipo"><option>Informe Final F-DC-125</option><option>Manual de usuario</option><option>Código fuente</option><option>Documento corregido</option><option>Otro entregable</option></select></label><label>Versión<input name="version" type="number" min="1" value="1" required></label></div><label>Enlace del archivo<input name="enlace" type="url" required maxlength="900" placeholder="https://..."></label><label>Observación<textarea name="comentario" maxlength="1200"></textarea></label><button>Registrar entrega</button></form></section></c:if><section class="panel"><h2>Control de versiones y revisión</h2><table><thead><tr><th>Proyecto</th><th>Archivo</th><th>Versión</th><th>Estado</th><th>Acción</th></tr></thead><tbody><c:forEach var="e" items="${entregas.rows}"><tr><td><c:out value="${e.codigo}"/></td><td><a href="<c:out value='${e.enlace}'/>" target="_blank" rel="noopener noreferrer"><c:out value="${e.tipo}"/> ↗</a></td><td><c:out value="${e.version}"/></td><td><span class="pill"><c:out value="${e.estado}"/></span></td><td><c:if test="${sessionScope.rol eq 'DIRECTOR' and e.estado eq 'ENVIADO' or sessionScope.rol eq 'EVALUADOR' and e.estado eq 'AVALADO'}"><form method="post"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="entrega" value="${e.id}"><input type="hidden" name="accion" value="${sessionScope.rol eq 'DIRECTOR' ? 'avalar' : 'evaluar'}"><label>Observaciones<input name="observacion" maxlength="300" required></label><button name="estado" value="${sessionScope.rol eq 'DIRECTOR' ? 'AVALADO' : 'EVALUADO'}">Aprobar</button><button name="estado" value="${sessionScope.rol eq 'DIRECTOR' ? 'DEVUELTO' : 'CORRECCION'}" class="secondary">Devolver</button></form></c:if></td></tr></c:forEach></tbody></table></section><%@ include file="/WEB-INF/jspf/pie.jspf" %>