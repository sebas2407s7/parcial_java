<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %>
<sql:query var="proyectosControl" dataSource="${db}">SELECT p.id,p.codigo,p.titulo,p.estado,p.modalidad,u.nombre AS estudiante FROM parcial_joan_carlos.anteproyectos p JOIN parcial_joan_carlos.usuarios u ON u.id=p.estudiante_id WHERE CAST(? AS TEXT)='COORDINACION' OR p.estudiante_id=CAST(? AS BIGINT) OR p.director_id=CAST(? AS BIGINT) OR p.evaluador_id=CAST(? AS BIGINT) ORDER BY p.id DESC LIMIT 70<sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${sessionScope.idUsuario}"/></sql:query><c:if test="${pageContext.request.method eq 'POST' and not empty sessionScope.csrf and param.csrf eq sessionScope.csrf and param.accion eq 'solicitar' and sessionScope.rol eq 'ESTUDIANTE'}"><c:catch var="fallo"><sql:update dataSource="${db}">INSERT INTO parcial_joan_carlos.cambios_control(anteproyecto_id,solicitante_id,origen,destino,motivo) SELECT id,CAST(? AS BIGINT),modalidad,CAST(? AS TEXT),CAST(? AS TEXT) FROM parcial_joan_carlos.anteproyectos WHERE id=CAST(? AS BIGINT) AND estudiante_id=CAST(? AS BIGINT) AND estado IN ('BORRADOR','PENDIENTE_DIRECTOR','DEVUELTO')<sql:param value="${sessionScope.idUsuario}"/><sql:param value="${param.destino}"/><sql:param value="${param.motivo}"/><sql:param value="${param.id}"/><sql:param value="${sessionScope.idUsuario}"/></sql:update></c:catch></c:if>
<c:if test="${pageContext.request.method eq 'POST' and not empty sessionScope.csrf and param.csrf eq sessionScope.csrf and param.accion eq 'resolver' and sessionScope.rol eq 'COORDINACION'}"><c:catch var="fallo"><sql:transaction dataSource="${db}"><sql:update>UPDATE parcial_joan_carlos.cambios_control SET estado=CAST(? AS TEXT),responsable_id=CAST(? AS BIGINT),resuelto_en=CURRENT_TIMESTAMP WHERE id=CAST(? AS BIGINT) AND estado='PENDIENTE'<sql:param value="${param.resultado}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${param.solicitud}"/></sql:update><sql:update>UPDATE parcial_joan_carlos.anteproyectos a SET modalidad=s.destino FROM parcial_joan_carlos.cambios_control s WHERE s.anteproyecto_id=a.id AND s.id=CAST(? AS BIGINT) AND s.estado='APROBADO' AND CAST(? AS TEXT)='APROBADO' AND a.estado IN ('BORRADOR','PENDIENTE_DIRECTOR','DEVUELTO')<sql:param value="${param.solicitud}"/><sql:param value="${param.resultado}"/></sql:update></sql:transaction></c:catch></c:if>
<sql:query var="cambios" dataSource="${db}">SELECT s.id,s.origen,s.destino,s.motivo,s.estado,s.fecha,p.codigo,u.nombre AS solicitante FROM parcial_joan_carlos.cambios_control s JOIN parcial_joan_carlos.anteproyectos p ON p.id=s.anteproyecto_id LEFT JOIN parcial_joan_carlos.usuarios u ON u.id=s.solicitante_id WHERE CAST(? AS TEXT)='COORDINACION' OR s.solicitante_id=CAST(? AS BIGINT) ORDER BY s.fecha DESC LIMIT 70<sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/></sql:query>
<c:set var="titulo" value="Cambios de modalidad"/><c:set var="subtitulo" value="Solicitudes con autorización de Coordinación y trazabilidad."/><%@ include file="/WEB-INF/jspf/cabecera.jspf" %><c:if test="${not empty fallo}"><div class="alert bad">No se pudo registrar la operación. Revisa la etapa o los permisos.</div></c:if><c:if test="${sessionScope.rol eq 'ESTUDIANTE'}"><section class="panel"><h2>Solicitar ajuste</h2><p>Solo se puede modificar durante las etapas iniciales permitidas.</p><form method="post"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><label>Expediente<select name="id" required><option value="">Selecciona un expediente</option><c:forEach var="p" items="${proyectosControl.rows}"><option value="${p.id}"><c:out value="${p.codigo}"/> · <c:out value="${p.titulo}"/></option></c:forEach></select></label><input type="hidden" name="accion" value="solicitar"><label>Modalidad de destino<select name="destino" required><option>Desarrollo Tecnológico</option><option>Proyecto de Investigación</option><option>Monografía</option><option>Práctica</option><option>Seminario</option><option>Emprendimiento</option></select></label><label>Justificación<textarea name="motivo" required maxlength="1200"></textarea></label><button>Enviar solicitud</button></form></section></c:if><section class="panel"><h2>Historial de solicitudes</h2><table><thead><tr><th>Proyecto</th><th>Anterior</th><th>Solicitada</th><th>Motivo</th><th>Estado</th><th>Decisión</th></tr></thead><tbody><c:forEach var="s" items="${cambios.rows}"><tr><td><c:out value="${s.codigo}"/></td><td><c:out value="${s.origen}"/></td><td><c:out value="${s.destino}"/></td><td><c:out value="${s.motivo}"/></td><td><c:out value="${s.estado}"/></td><td><c:if test="${sessionScope.rol eq 'COORDINACION' and s.estado eq 'PENDIENTE'}"><form method="post" class="action-row"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="solicitud" value="${s.id}"><input type="hidden" name="accion" value="resolver"><button name="resultado" value="APROBADO">Aprobar</button><button class="secondary" name="resultado" value="RECHAZADO">Rechazar</button></form></c:if></td></tr></c:forEach></tbody></table></section><%@ include file="/WEB-INF/jspf/pie.jspf" %>