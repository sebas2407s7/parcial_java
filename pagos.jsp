<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %>
<c:if test="${sessionScope.rol eq 'ADMINISTRADOR'}"><c:redirect url="/panel.jsp"/></c:if>
<sql:query var="proyectosControl" dataSource="${db}">SELECT p.id,p.codigo,p.titulo,p.estado,p.modalidad,u.nombre AS estudiante FROM parcial_joan_carlos.anteproyectos p JOIN parcial_joan_carlos.usuarios u ON u.id=p.estudiante_id WHERE CAST(? AS TEXT)='COORDINACION' OR p.estudiante_id=CAST(? AS BIGINT) OR p.director_id=CAST(? AS BIGINT) OR p.evaluador_id=CAST(? AS BIGINT) ORDER BY p.id DESC LIMIT 70<sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${sessionScope.idUsuario}"/></sql:query><c:if test="${pageContext.request.method eq 'POST' and not empty sessionScope.csrf and param.csrf eq sessionScope.csrf and param.accion eq 'registrar' and sessionScope.rol eq 'ESTUDIANTE'}"><c:catch var="fallo"><sql:update dataSource="${db}">INSERT INTO parcial_joan_carlos.pagos_control(anteproyecto_id,estudiante_id,periodo,referencia,valor,comprobante_url) SELECT p.id,CAST(? AS BIGINT),CAST(? AS TEXT),CAST(? AS TEXT),CAST(? AS NUMERIC),CAST(? AS TEXT) FROM parcial_joan_carlos.anteproyectos p WHERE p.id=CAST(? AS BIGINT) AND p.estudiante_id=CAST(? AS BIGINT) <sql:param value="${sessionScope.idUsuario}"/><sql:param value="${param.periodo}"/><sql:param value="${param.referencia}"/><sql:param value="${param.valor}"/><sql:param value="${param.enlace}"/><sql:param value="${param.id}"/><sql:param value="${sessionScope.idUsuario}"/></sql:update></c:catch></c:if>
<c:if test="${pageContext.request.method eq 'POST' and not empty sessionScope.csrf and param.csrf eq sessionScope.csrf and param.accion eq 'validar' and sessionScope.rol eq 'COORDINACION'}"><c:catch var="fallo"><sql:update dataSource="${db}">UPDATE parcial_joan_carlos.pagos_control SET estado=CAST(? AS TEXT),validado_por=CAST(? AS BIGINT) WHERE id=CAST(? AS BIGINT) AND CAST(? AS TEXT) IN ('VALIDADO','RECHAZADO') <sql:param value="${param.estado}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${param.pago}"/><sql:param value="${param.estado}"/></sql:update></c:catch></c:if>
<sql:query var="pagos" dataSource="${db}">SELECT a.id,a.referencia,a.valor,a.periodo,a.estado,a.fecha,p.codigo,p.titulo,u.nombre estudiante FROM parcial_joan_carlos.pagos_control a JOIN parcial_joan_carlos.anteproyectos p ON p.id=a.anteproyecto_id JOIN parcial_joan_carlos.usuarios u ON u.id=a.estudiante_id WHERE CAST(? AS TEXT)='COORDINACION' OR a.estudiante_id=CAST(? AS BIGINT) OR p.director_id=CAST(? AS BIGINT) ORDER BY a.fecha DESC LIMIT 100<sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${sessionScope.idUsuario}"/></sql:query>
<c:set var="titulo" value="Pagos y vigencia"/><c:set var="subtitulo" value="Soportes de pago asociados a expedientes, periodos y modalidades."/><%@ include file="/WEB-INF/jspf/cabecera.jspf" %><c:if test="${not empty fallo}"><div class="alert bad">No se pudo guardar el movimiento. Comprueba los campos y si ya existe esa referencia.</div></c:if>
<c:if test="${sessionScope.rol eq 'ESTUDIANTE'}"><section class="panel"><h2>Registrar soporte de pago</h2><form method="post"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><label>Expediente<select name="id" required><option value="">Selecciona un expediente</option><c:forEach var="p" items="${proyectosControl.rows}"><option value="${p.id}"><c:out value="${p.codigo}"/> · <c:out value="${p.titulo}"/></option></c:forEach></select></label><input type="hidden" name="accion" value="registrar"><div class="grid"><label>Periodo<input name="periodo" maxlength="40" required placeholder="2026-2"></label><label>Referencia<input name="referencia" maxlength="90" required></label><label>Valor<input type="number" step="0.01" min="0" name="valor" required></label><label>URL del comprobante<input type="url" name="enlace" maxlength="900" placeholder="https://..."></label></div><button class="primary">Guardar pago</button></form></section></c:if>
<section class="panel"><h2>Movimientos registrados</h2><table><thead><tr><th>Expediente</th><th>Periodo</th><th>Referencia</th><th>Valor</th><th>Estado</th><th>Acción</th></tr></thead><tbody><c:forEach var="a" items="${pagos.rows}"><tr><td><c:out value="${a.codigo}"/></td><td><c:out value="${a.periodo}"/></td><td><c:out value="${a.referencia}"/></td><td><c:out value="${a.valor}"/></td><td><span class="pill"><c:out value="${a.estado}"/></span></td><td><c:if test="${sessionScope.rol eq 'COORDINACION' and a.estado eq 'PENDIENTE'}"><form method="post" class="action-row"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="accion" value="validar"><input type="hidden" name="pago" value="${a.id}"><button name="estado" value="VALIDADO">Validar</button><button name="estado" value="RECHAZADO" class="secondary">Rechazar</button></form></c:if></td></tr></c:forEach></tbody></table><c:if test="${empty pagos.rows}"><p class="empty">Aún no hay comprobantes registrados.</p></c:if></section><%@ include file="/WEB-INF/jspf/pie.jspf" %>