<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>
<%@ include file="/WEB-INF/jspf/seguridad.jspf" %>
<c:if test="${sessionScope.rol ne 'DIRECTOR' and sessionScope.rol ne 'EVALUADOR'}"><c:redirect url="/panel.jsp"/></c:if>
<c:if test="${pageContext.request.method eq 'POST' and not empty sessionScope.csrf and param.csrf eq sessionScope.csrf and param.accion eq 'calificar'}"><c:catch var="errorRevision">
<c:choose><c:when test="${sessionScope.rol eq 'DIRECTOR'}"><sql:update var="cantidad" dataSource="${db}">UPDATE parcial_joan_carlos.anteproyectos SET estado=CASE WHEN CAST(? AS TEXT)='APROBADO' THEN 'PENDIENTE_EVALUADOR' ELSE 'DEVUELTO' END,actualizado_en=CURRENT_TIMESTAMP WHERE id=CAST(? AS BIGINT) AND director_id=CAST(? AS BIGINT) AND estado='PENDIENTE_DIRECTOR'
<sql:param value="${param.decision}"/><sql:param value="${param.id}"/><sql:param value="${sessionScope.idUsuario}"/></sql:update></c:when>
<c:otherwise><sql:update var="cantidad" dataSource="${db}">UPDATE parcial_joan_carlos.anteproyectos SET estado=CASE WHEN CAST(? AS TEXT)='APROBADO' THEN 'APROBADO' ELSE 'DEVUELTO' END,calificacion=CAST(? AS NUMERIC),actualizado_en=CURRENT_TIMESTAMP WHERE id=CAST(? AS BIGINT) AND evaluador_id=CAST(? AS BIGINT) AND estado='PENDIENTE_EVALUADOR'
<sql:param value="${param.decision}"/><sql:param value="${param.nota}"/><sql:param value="${param.id}"/><sql:param value="${sessionScope.idUsuario}"/></sql:update></c:otherwise></c:choose>
<c:if test="${cantidad gt 0}"><sql:update dataSource="${db}">UPDATE parcial_joan_carlos.anteproyectos SET fecha_director=CASE WHEN CAST(? AS TEXT)='DIRECTOR' THEN CURRENT_TIMESTAMP ELSE fecha_director END, fecha_evaluador=CASE WHEN CAST(? AS TEXT)='EVALUADOR' THEN CURRENT_TIMESTAMP ELSE fecha_evaluador END WHERE id=CAST(? AS BIGINT)<sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${param.id}"/></sql:update><sql:update dataSource="${db}">INSERT INTO parcial_joan_carlos.revisiones(anteproyecto_id,revisor_id,tipo,decision,nota,observaciones) VALUES(CAST(? AS BIGINT),CAST(? AS BIGINT),CAST(? AS TEXT),CAST(? AS TEXT),CAST(? AS NUMERIC),?)
<sql:param value="${param.id}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${param.decision}"/><sql:param value="${param.nota}"/><sql:param value="${param.observaciones}"/></sql:update>
<sql:update dataSource="${db}">INSERT INTO parcial_joan_carlos.auditoria(usuario_id,entidad,accion,detalle) VALUES(CAST(? AS BIGINT),CAST(? AS TEXT),CAST(? AS TEXT),CAST(? AS TEXT))
<sql:param value="${sessionScope.idUsuario}"/><sql:param value="revisiones"/><sql:param value="${param.accion}"/><sql:param value="${param.decision}"/></sql:update>
<sql:update dataSource="${db}">INSERT INTO parcial_joan_carlos.historial(anteproyecto_id,actor_id,evento,detalle) VALUES(CAST(? AS BIGINT),CAST(? AS BIGINT),'Evaluación académica',CAST(? AS TEXT))
<sql:param value="${param.id}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${param.decision}"/></sql:update><sql:update dataSource="${db}">INSERT INTO parcial_joan_carlos.notificaciones(usuario_id,anteproyecto_id,mensaje) SELECT estudiante_id,id,CASE WHEN CAST(? AS TEXT)='APROBADO' THEN 'Tu anteproyecto ha recibido un aval académico.' ELSE 'Se solicitaron correcciones a tu anteproyecto.' END FROM parcial_joan_carlos.anteproyectos WHERE id=CAST(? AS BIGINT)<sql:param value="${param.decision}"/><sql:param value="${param.id}"/></sql:update>
<sql:update dataSource="${db}">INSERT INTO parcial_joan_carlos.notificaciones(usuario_id,anteproyecto_id,mensaje) SELECT evaluador_id,id,'Hay una nueva propuesta avalada por el Director.' FROM parcial_joan_carlos.anteproyectos WHERE id=CAST(? AS BIGINT) AND CAST(? AS TEXT)='DIRECTOR' AND evaluador_id IS NOT NULL AND estado='PENDIENTE_EVALUADOR'<sql:param value="${param.id}"/><sql:param value="${sessionScope.rol}"/></sql:update></c:if>
</c:catch><c:if test="${empty errorRevision}"><c:redirect url="/revisiones.jsp?ok=1"/></c:if></c:if>
<sql:query var="asignados" dataSource="${db}">SELECT p.id,p.titulo,p.resumen,p.objetivos,p.enlace_archivo,p.estado,s.nombre AS estudiante FROM parcial_joan_carlos.anteproyectos p JOIN parcial_joan_carlos.usuarios s ON s.id=p.estudiante_id WHERE (CAST(? AS TEXT)='DIRECTOR' AND p.director_id=CAST(? AS BIGINT)) OR (CAST(? AS TEXT)='EVALUADOR' AND p.evaluador_id=CAST(? AS BIGINT)) ORDER BY p.actualizado_en DESC
<sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/></sql:query>
<c:set var="titulo" value="Revisión de anteproyectos"/><c:set var="subtitulo" value="Registra el concepto y la calificación para continuar el proceso académico."/>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %>
<c:if test="${param.ok eq '1'}"><div class="alert good">Evaluación registrada.</div></c:if><c:if test="${not empty errorRevision}"><div class="alert bad">No se pudo completar la evaluación; revisa el estado y los campos.</div></c:if>
<c:forEach items="${asignados.rows}" var="p"><div class="panel review-card"><div class="panel-head"><div><span class="eyebrow accent">ANTEPROYECTO #<c:out value="${p.id}"/></span><h2><c:out value="${p.titulo}"/></h2><p>Estudiante: <c:out value="${p.estudiante}"/></p></div><span class="chip"><c:out value="${p.estado}"/></span></div><div class="review-body"><div><strong>Descripción</strong><p><c:out value="${p.resumen}"/></p><strong>Objetivos</strong><p><c:out value="${p.objetivos}"/></p><c:if test="${fn:startsWith(p.enlace_archivo, 'https://') or fn:startsWith(p.enlace_archivo, 'http://')}"><a href="<c:out value='${p.enlace_archivo}'/>" target="_blank" rel="noopener noreferrer">Ver documento ↗</a></c:if></div>
<div><c:choose><c:when test="${(sessionScope.rol eq 'DIRECTOR' and p.estado eq 'PENDIENTE_DIRECTOR') or (sessionScope.rol eq 'EVALUADOR' and p.estado eq 'PENDIENTE_EVALUADOR')}"><form class="stack" method="post" data-confirm="¿Registrar esta evaluación? La decisión se enviará al siguiente rol."><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="calificar"><input type="hidden" name="id" value="${p.id}"><label>Decisión<select name="decision" required><option value="APROBADO">Aprobar</option><option value="DEVUELTO">Devolver con observaciones</option></select></label><label>Calificación (0 a 5)<input type="number" name="nota" min="0" max="5" step="0.1" required placeholder="4.5"></label><label>Observaciones<textarea name="observaciones" required rows="4" placeholder="Escribe la retroalimentación"></textarea></label><button class="primary" type="submit">Registrar evaluación →</button></form></c:when><c:otherwise><div class="empty-note">Esta entrega no está pendiente de tu revisión actualmente.</div></c:otherwise></c:choose><a class="btn ghost" href="<c:url value='/detalle.jsp'><c:param name='id' value='${p.id}'/></c:url>">Historial y calificaciones</a></div></div></div></c:forEach>
<c:if test="${asignados.rowCount eq 0}"><div class="panel empty-note">No tienes anteproyectos asignados todavía.</div></c:if>
<%@ include file="/WEB-INF/jspf/pie.jspf" %>
