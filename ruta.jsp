<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %>
<c:if test="${sessionScope.rol ne 'ESTUDIANTE'}"><c:redirect url="/panel.jsp"/></c:if>
<sql:query var="perfil" dataSource="${db}">SELECT nombre,programa,nivel,plan,creditos,metodologia,seminario_i,seminario_ii,seminario_iii,seminario_iv,matricula_seminario_i,matricula_seminario_iii FROM parcial_joan_carlos.usuarios WHERE id=CAST(? AS BIGINT)<sql:param value="${sessionScope.idUsuario}"/></sql:query><c:set var="u" value="${perfil.rows[0]}"/>
<c:set var="titulo" value="Ruta de habilitación"/><c:set var="subtitulo" value="Consulta de condiciones académicas por nivel y plan de estudios."/><%@ include file="/WEB-INF/jspf/cabecera.jspf" %><section class="panel"><h2>Evaluación de elegibilidad</h2><div class="details-grid"><div><span>Estudiante</span><strong><c:out value="${u.nombre}"/></strong></div><div><span>Nivel</span><strong><c:out value="${u.nivel}" default="No registrado"/></strong></div><div><span>Plan de estudios</span><strong><c:out value="${u.plan}" default="Por confirmar"/></strong></div><div><span>Créditos</span><strong><c:out value="${u.creditos}"/> %</strong></div></div></section>
<div class="journey"><article class="journey-step"><div class="num">01</div><h3>Proyecto de investigación</h3><p>Planes anteriores: 75 % de créditos y Metodología.</p><strong>${u.plan eq 'ANTERIOR' and u.creditos ge 75 and u.metodologia ? 'Habilitado según datos' : 'Validación pendiente'}</strong></article><article class="journey-step"><div class="num">02</div><h3>Seminario</h3><p>Planes anteriores: 90 % y Metodología. Planes nuevos: seminarios según nivel.</p><strong>${u.plan eq 'ANTERIOR' and u.creditos ge 90 and u.metodologia ? 'Habilitado según datos' : 'Validación pendiente'}</strong></article><article class="journey-step"><div class="num">03</div><h3>Práctica</h3><p>Validación de nivel y créditos; Técnico Profesional limitado a práctica.</p><strong>${u.nivel eq 'TECNICO_PROFESIONAL' ? 'Modalidad permitida por nivel' : 'Validar requisitos'}</strong></article><article class="journey-step"><div class="num">04</div><h3>Plan posterior al Decreto 1330</h3><p>Matrícula y aprobación de seminarios I-IV según etapa académica.</p><strong>${u.plan eq 'POSTERIOR' ? 'Aplican reglas de seminarios' : 'No aplica / verificar'}</strong></article></div><section class="panel"><h2>Condiciones para crear un proyecto</h2><p>Antes de enviar, Coordinación valida el número de integrantes, la matrícula, la modalidad y el periodo. Se conserva el historial de cada respuesta.</p><a class="btn" href="<c:url value='/anteproyectos.jsp'/>">Ir a los anteproyectos ↗</a></section><%@ include file="/WEB-INF/jspf/pie.jspf" %>