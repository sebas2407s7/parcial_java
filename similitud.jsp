<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %><%@ include file="/WEB-INF/jspf/seguridad.jspf" %>
<c:if test="${sessionScope.rol ne 'DIRECTOR' and sessionScope.rol ne 'EVALUADOR'}"><c:redirect url="/panel.jsp"/></c:if>
<c:if test="${pageContext.request.method eq 'POST' and param.csrf eq sessionScope.csrf and not empty sessionScope.csrf}"><c:catch var="fallo"><sql:update dataSource="${db}">INSERT INTO parcial_joan_carlos.similitud_control(anteproyecto_id,responsable_id,porcentaje,reporte_url,observacion) SELECT p.id,CAST(? AS BIGINT),CAST(? AS NUMERIC),CAST(? AS TEXT),CAST(? AS TEXT) FROM parcial_joan_carlos.anteproyectos p WHERE p.id=CAST(? AS BIGINT) AND ((CAST(? AS TEXT)='DIRECTOR' AND p.director_id=CAST(? AS BIGINT)) OR (CAST(? AS TEXT)='EVALUADOR' AND p.evaluador_id=CAST(? AS BIGINT)))<sql:param value="${sessionScope.idUsuario}"/><sql:param value="${param.porcentaje}"/><sql:param value="${param.enlace}"/><sql:param value="${param.observacion}"/><sql:param value="${param.id}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/></sql:update></c:catch></c:if>
<sql:query var="asignados" dataSource="${db}">SELECT id,codigo,titulo FROM parcial_joan_carlos.anteproyectos WHERE (CAST(? AS TEXT)='DIRECTOR' AND director_id=CAST(? AS BIGINT)) OR (CAST(? AS TEXT)='EVALUADOR' AND evaluador_id=CAST(? AS BIGINT)) ORDER BY id DESC<sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/><sql:param value="${sessionScope.rol}"/><sql:param value="${sessionScope.idUsuario}"/></sql:query>
<sql:query var="registros" dataSource="${db}">SELECT s.porcentaje,s.reporte_url,s.observacion,s.fecha,p.codigo FROM parcial_joan_carlos.similitud_control s JOIN parcial_joan_carlos.anteproyectos p ON p.id=s.anteproyecto_id WHERE p.director_id=CAST(? AS BIGINT) OR p.evaluador_id=CAST(? AS BIGINT) ORDER BY s.fecha DESC LIMIT 80<sql:param value="${sessionScope.idUsuario}"/><sql:param value="${sessionScope.idUsuario}"/></sql:query>
<c:set var="titulo" value="Control de similitud"/><c:set var="subtitulo" value="Registro académico del resultado del informe de similitud (Turnitin), cuando corresponda."/><%@ include file="/WEB-INF/jspf/cabecera.jspf" %><section class="panel"><h2>Asentar revisión</h2><c:if test="${not empty fallo}"><div class="alert bad">No se pudo guardar el registro.</div></c:if><form method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><label>Expediente<select name="id" required><c:forEach var="a" items="${asignados.rows}"><option value="${a.id}"><c:out value="${a.codigo}"/> · <c:out value="${a.titulo}"/></option></c:forEach></select></label><div class="grid"><label>Porcentaje<input type="number" min="0" max="100" step="0.01" name="porcentaje" required></label><label>Enlace al reporte<input type="url" name="enlace" maxlength="900" placeholder="https://..."></label></div><label>Observación<textarea name="observacion" maxlength="1100" required></textarea></label><button>Guardar revisión</button></form></section><section class="panel"><h2>Registros disponibles</h2><table><thead><tr><th>Proyecto</th><th>Similitud</th><th>Observaciones</th><th>Fecha</th></tr></thead><tbody><c:forEach var="r" items="${registros.rows}"><tr><td><c:out value="${r.codigo}"/></td><td><c:out value="${r.porcentaje}"/>%</td><td><c:out value="${r.observacion}"/></td><td><c:out value="${r.fecha}"/></td></tr></c:forEach></tbody></table></section><%@ include file="/WEB-INF/jspf/pie.jspf" %>