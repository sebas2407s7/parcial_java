<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="sql" uri="http://java.sun.com/jsp/jstl/sql" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ include file="/WEB-INF/jspf/seguridad.jspf" %><c:set var="rolNecesario" value="ADMINISTRADOR"/><%@ include file="/WEB-INF/jspf/roles.jspf" %>
<c:if test="${pageContext.request.method eq 'POST' and not empty sessionScope.csrf and param.csrf eq sessionScope.csrf}">
<c:catch var="errorOperacion"><c:choose>
<c:when test="${param.accion eq 'crear' and not empty param.nombre and not empty param.correo and not empty param.clave}">
<sql:update dataSource="${db}">WITH generador AS (SELECT md5(random()::text) AS sal) INSERT INTO parcial_joan_carlos.usuarios(nombre,correo,rol,programa,sal,clave_hash,identificacion,nivel,plan,creditos,metodologia) SELECT CAST(? AS TEXT),lower(CAST(? AS TEXT)),CAST(? AS TEXT),CAST(? AS TEXT),generador.sal,encode(sha256(convert_to(generador.sal || CAST(? AS TEXT),'UTF8')),'hex'),CAST(? AS TEXT),CAST(? AS TEXT),CAST(? AS TEXT),CAST(? AS SMALLINT),CAST(? AS BOOLEAN) FROM generador
<sql:param value="${param.nombre}"/><sql:param value="${param.correo}"/><sql:param value="${param.rol}"/><sql:param value="${param.programa}"/><sql:param value="${param.clave}"/><sql:param value="${param.identificacion}"/><sql:param value="${param.nivel}"/><sql:param value="${param.plan}"/><sql:param value="${empty param.creditos ? '0':param.creditos}"/><sql:param value="${param.metodologia eq 'true'}"/></sql:update></c:when>
<c:when test="${param.accion eq 'editar'}"><sql:update dataSource="${db}">UPDATE parcial_joan_carlos.usuarios SET nombre=?,rol=?,programa=?,identificacion=?,nivel=?,plan=?,creditos=CAST(? AS SMALLINT),metodologia=CAST(? AS BOOLEAN) WHERE id=CAST(? AS BIGINT)
<sql:param value="${param.nombre}"/><sql:param value="${param.rol}"/><sql:param value="${param.programa}"/><sql:param value="${param.identificacion}"/><sql:param value="${param.nivel}"/><sql:param value="${param.plan}"/><sql:param value="${empty param.creditos ? '0':param.creditos}"/><sql:param value="${param.metodologia eq 'true'}"/><sql:param value="${param.id}"/></sql:update>
<c:if test="${not empty param.clave}"><sql:update dataSource="${db}">UPDATE parcial_joan_carlos.usuarios SET clave_hash=encode(sha256(convert_to(sal||CAST(? AS TEXT),'UTF8')),'hex') WHERE id=CAST(? AS BIGINT)<sql:param value="${param.clave}"/><sql:param value="${param.id}"/></sql:update></c:if></c:when>
<c:when test="${param.accion eq 'eliminar' and param.id ne sessionScope.idUsuario}"><sql:update dataSource="${db}">DELETE FROM parcial_joan_carlos.usuarios WHERE id=CAST(? AS BIGINT) AND rol != 'ADMINISTRADOR' AND NOT EXISTS(SELECT 1 FROM parcial_joan_carlos.anteproyectos p WHERE p.estudiante_id=CAST(? AS BIGINT) OR p.director_id=CAST(? AS BIGINT) OR p.evaluador_id=CAST(? AS BIGINT)) AND NOT EXISTS(SELECT 1 FROM parcial_joan_carlos.revisiones r WHERE r.revisor_id=CAST(? AS BIGINT)) AND NOT EXISTS(SELECT 1 FROM parcial_joan_carlos.ideas i WHERE i.creado_por=CAST(? AS BIGINT)) AND NOT EXISTS(SELECT 1 FROM parcial_joan_carlos.historial h WHERE h.actor_id=CAST(? AS BIGINT)) AND NOT EXISTS(SELECT 1 FROM parcial_joan_carlos.documentos d WHERE d.usuario_id=CAST(? AS BIGINT)) AND NOT EXISTS(SELECT 1 FROM parcial_joan_carlos.integrantes i WHERE i.estudiante_id=CAST(? AS BIGINT)) AND NOT EXISTS(SELECT 1 FROM parcial_joan_carlos.notificaciones n WHERE n.usuario_id=CAST(? AS BIGINT)) AND NOT EXISTS(SELECT 1 FROM parcial_joan_carlos.notas_criterios n WHERE n.evaluador_id=CAST(? AS BIGINT)) AND NOT EXISTS(SELECT 1 FROM parcial_joan_carlos.decisiones d WHERE d.coordinador_id=CAST(? AS BIGINT)) AND NOT EXISTS(SELECT 1 FROM parcial_joan_carlos.versiones v WHERE v.autor_id=CAST(? AS BIGINT)) AND NOT EXISTS(SELECT 1 FROM parcial_joan_carlos.auditoria a WHERE a.usuario_id=CAST(? AS BIGINT))
<sql:param value="${param.id}"/><sql:param value="${param.id}"/><sql:param value="${param.id}"/><sql:param value="${param.id}"/><sql:param value="${param.id}"/><sql:param value="${param.id}"/><sql:param value="${param.id}"/><sql:param value="${param.id}"/><sql:param value="${param.id}"/><sql:param value="${param.id}"/><sql:param value="${param.id}"/><sql:param value="${param.id}"/><sql:param value="${param.id}"/><sql:param value="${param.id}"/></sql:update></c:when>
<c:when test="${param.accion eq 'cambiar' and param.id ne sessionScope.idUsuario}"><sql:update dataSource="${db}">UPDATE parcial_joan_carlos.usuarios SET activo=NOT activo WHERE id=CAST(? AS BIGINT)<sql:param value="${param.id}"/></sql:update></c:when>
</c:choose><sql:update dataSource="${db}">INSERT INTO parcial_joan_carlos.auditoria(usuario_id,entidad,accion,detalle) VALUES(CAST(? AS BIGINT),'usuarios',?,?)<sql:param value="${sessionScope.idUsuario}"/><sql:param value="${param.accion}"/><sql:param value="${param.correo}"/></sql:update></c:catch>
<c:if test="${empty errorOperacion}"><c:redirect url="/usuarios.jsp?ok=1"/></c:if>
</c:if>
<sql:query var="usuarios" dataSource="${db}">SELECT id,nombre,correo,rol,programa,nivel,activo FROM parcial_joan_carlos.usuarios ORDER BY id DESC</sql:query>
<c:if test="${not empty param.editar}"><sql:query var="edicion" dataSource="${db}">SELECT id,nombre,correo,rol,programa,identificacion,nivel,plan,creditos,metodologia FROM parcial_joan_carlos.usuarios WHERE id=CAST(? AS BIGINT)<sql:param value="${param.editar}"/></sql:query></c:if>
<c:set var="titulo" value="Gestión de usuarios"/><c:set var="subtitulo" value="El administrador crea cuentas y define sus permisos."/>
<%@ include file="/WEB-INF/jspf/cabecera.jspf" %>
<c:if test="${not empty errorOperacion}"><div class="alert bad">No se pudo guardar: verifica el correo, el rol y que el usuario no tenga registros relacionados para poder eliminarlo.</div></c:if><c:if test="${param.ok eq '1'}"><div class="alert good">Cambios guardados correctamente.</div></c:if>
<div class="split"><div class="panel"><h2><c:choose><c:when test="${edicion.rowCount gt 0}">Editar cuenta</c:when><c:otherwise>Registrar nuevo usuario</c:otherwise></c:choose></h2>
<form method="post" class="stack"><input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>"><input type="hidden" name="accion" value="${edicion.rowCount gt 0 ? 'editar':'crear'}"><input type="hidden" name="id" value="<c:out value='${edicion.rows[0].id}'/>">
<label>Nombre completo<input name="nombre" required maxlength="160" value="<c:out value='${edicion.rows[0].nombre}'/>" placeholder="Nombre y apellido"></label>
<label>Correo electrónico<input type="email" name="correo" required maxlength="180" value="<c:out value='${edicion.rows[0].correo}'/>" <c:if test="${edicion.rowCount gt 0}">readonly</c:if>></label>
<label>Rol<select name="rol" required><c:forTokens items="ADMINISTRADOR,COORDINACION,DIRECTOR,EVALUADOR,ESTUDIANTE" delims="," var="r"><option value="${r}" ${edicion.rowCount gt 0 and edicion.rows[0].rol eq r ? 'selected':''}><c:out value="${r}"/></option></c:forTokens></select></label>
<label>Programa académico<input name="programa" maxlength="150" value="<c:out value='${edicion.rows[0].programa}'/>" placeholder="Ingeniería de Sistemas"></label>
<label>Documento de identidad<input name="identificacion" maxlength="35" value="<c:out value='${edicion.rows[0].identificacion}'/>" placeholder="Identificación"></label>
<label>Nivel de formación<select name="nivel"><option value="">Por definir</option><option value="TECNOLOGICO" ${edicion.rows[0].nivel eq 'TECNOLOGICO'?'selected':''}>Tecnológico</option><option value="PROFESIONAL" ${edicion.rows[0].nivel eq 'PROFESIONAL'?'selected':''}>Profesional</option><option value="TECNICO" ${edicion.rows[0].nivel eq 'TECNICO'?'selected':''}>Técnico</option></select></label>
<label>Tipo de plan<select name="plan"><option value="">Sin registrar</option><option value="ANTERIOR" ${edicion.rows[0].plan eq 'ANTERIOR'?'selected':''}>Anterior al Decreto 1330</option><option value="POSTERIOR" ${edicion.rows[0].plan eq 'POSTERIOR'?'selected':''}>Posterior al Decreto 1330</option></select></label>
<label>Porcentaje de créditos aprobados<input name="creditos" type="number" min="0" max="100" value="${empty edicion.rows[0].creditos?'0':edicion.rows[0].creditos}"/></label>
<label>Metodología académica<select name="metodologia"><option value="false">No registrada</option><option value="true" ${edicion.rows[0].metodologia eq true?'selected':''}>Aprobada</option></select></label>
<label>Contraseña <small><c:if test="${edicion.rowCount gt 0}">(Opcional: deja en blanco para conservarla)</c:if></small><input type="password" name="clave" ${edicion.rowCount gt 0 ? '' : 'required'} minlength="8" placeholder="Mínimo 8 caracteres"></label>
<button class="primary" type="submit">Guardar usuario</button><c:if test="${edicion.rowCount gt 0}"><a class="btn ghost" href="<c:url value='/usuarios.jsp'/>">Cancelar edición</a></c:if></form></div>
<div class="panel"><div class="search-line"><h2>Usuarios registrados</h2><label>Buscar<input type="search" data-table-search="usuariosTabla" placeholder="Nombre, correo, rol o programa"/></label></div><div class="table-wrap"><table id="usuariosTabla"><thead><tr><th>Nombre</th><th>Correo</th><th>Rol</th><th>Programa</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
<c:forEach items="${usuarios.rows}" var="u"><tr><td><strong><c:out value="${u.nombre}"/></strong></td><td><c:out value="${u.correo}"/></td><td><span class="chip"><c:out value="${u.rol}"/></span></td><td><c:out value="${u.programa}"/></td><td><span class="chip ${u.activo ? 'green' : 'gray'}">${u.activo ? 'Activo' : 'Inactivo'}</span></td><td class="actions"><a class="btn small" href="<c:url value='/usuarios.jsp'><c:param name='editar' value='${u.id}'/></c:url>">Editar</a><c:if test="${u.id ne sessionScope.idUsuario}"><form method="post" class="inline" data-confirm="¿Cambiar el estado de este usuario?"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="accion" value="cambiar"><input type="hidden" name="id" value="${u.id}"><button class="btn small danger" type="submit">${u.activo ? 'Desactivar':'Activar'}</button></form><form method="post" class="inline" data-confirm="Eliminará este usuario únicamente si no tiene registros vinculados. ¿Continuar?"><input type="hidden" name="csrf" value="${sessionScope.csrf}"/><input type="hidden" name="accion" value="eliminar"/><input type="hidden" name="id" value="${u.id}"/><button class="btn small danger" type="submit">Eliminar</button></form></c:if></td></tr></c:forEach></tbody></table></div></div></div>
<%@ include file="/WEB-INF/jspf/pie.jspf" %>
